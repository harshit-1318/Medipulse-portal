# ==============================================================================
# MediPulse Portal — Environment Variable Template (.env.example)
# Copy this file to .env.local and configure your backend API URL.
# ==============================================================================

# Your Custom Backend API Base URL (Change to your backend URL)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
SERVER_API_BASE_URL=http://localhost:5000

# Multi-Tenant Site Defaults
NEXT_PUBLIC_DEFAULT_SITE_HOST=portal.medipulse.co.uk
NEXT_PUBLIC_SURVEY_TOKEN_HEADER=X-Survey-Token

# Feature Flags
NEXT_PUBLIC_AUTO_RESYNC=true

# Debug Options
NEXT_PUBLIC_ENABLE_DEBUG_LOGS=false
NEXT_PUBLIC_DEBUG_VIDEO_RECORDINGS=false
NEXT_PUBLIC_DEBUG_IDLE_TIMER=false

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?appName=Cluster0

# Authentication & Security
AUTH_COOKIE_NAME=token
JWT_SECRET=medipulse-default-jwt-secret-key-at-least-32-chars-long

