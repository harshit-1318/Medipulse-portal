  "cards": [
    {
      "dot": "cyan",
      "title": "Routing & Security Proxy",
      "items": [
        "Next.js 16 Edge Proxy (src/proxy.ts) guards all protected SSR navigations.",
        "Derives roles from cryptographically signed JWT cookies to prevent spoofing.",
        "Enforces strict RBAC for super admins (/super-dashboard, /sites, /users) and clinical roles."
      ]
    },
    {
      "dot": "emerald",
      "title": "Unified Client & Network Layer",
      "items": [
        "Client state managed via TanStack Query v5 (server data) and Zustand (session/site/loader).",
        "Axios singleton (apiClient) automatically attaches Bearer tokens and multi-tenant headers.",
        "Dual-backend flexibility: executes local App Router API routes or rewrites to external NestJS."
      ]
    },
    {
      "dot": "rose",
      "title": "Data Persistence & Audit Trail",
      "items": [
        "Direct connection to MongoDB Atlas using reusable global connection pooling.",
        "Mongoose schemas enforce strict typing for Orders, Customers, Leads, Surveys, and Users.",
        "Every critical operation records an immutable audit log entry in the ActivityLog collection."
      ]
    }
  ]
